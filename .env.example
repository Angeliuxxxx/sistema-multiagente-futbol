# Copia este archivo como .env (el .env real NO se sube a Git).
# Carpeta con modelo_predictivo_laliga.pkl y team_matches.csv (por defecto: ./data)
# DATA_DIR=
# Modelo local de Ollama para el agente de conocimiento
OLLAMA_MODEL=qwen2.5:7b

# Registro de predicciones: 1 (por defecto) = al arrancar la API se guardan los pronósticos de los próximos 10 días en
# data/registro_predicciones.jsonl. Pon 0 al desarrollar o probar para no ensuciar ese archivo versionado.
# (POST /actualizar y `python -m scripts.registro_predicciones registrar` registran igual con 0.)
# REGISTRAR_AL_ARRANCAR=1
# Token gratuito de football-data.org (calendario y resultados recientes). Sin él, el sistema usa los CSV y la última caché.
# FOOTBALL_DATA_KEY=
